---
import '../styles/global.css';
import { copies, type Locale } from '../lib/content';
const { locale = 'fr', title = 'Ibidun Farming' } = Astro.props as { locale?: Locale; title?: string };
const copy = copies[locale];
const path = Astro.url.pathname.replace(/^\/en/, '') || '/';
const alternate = locale === 'fr' ? `/en${path === '/' ? '' : path}` : path || '/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.home.intro} />
    <link rel="alternate" hreflang={locale === 'fr' ? 'en' : 'fr'} href={alternate} />
    <title>{title} — Ibidun Farming</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={locale === 'fr' ? '/' : '/en/'} aria-label="Ibidun Farming home">
        <span class="brand-mark">if</span><span>IBIDUN<br /><small>FARMING</small></span>
      </a>
      <nav aria-label="Main navigation">
        {Object.entries(copy.navigation).map(([key, label]) => <a href={`${locale === 'en' ? '/en' : ''}/${key === 'about' ? (locale === 'en' ? 'about' : 'a-propos') : key}`}>{label}</a>)}
      </nav>
      <a class="lang" href={alternate}>{copy.label === 'FR' ? 'EN' : 'FR'}</a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div><span class="brand-mark">if</span><p>La passion au cœur de la vision.</p></div>
      <div><p>© {new Date().getFullYear()} Ibidun Farming</p><a href="mailto:contact@ibidunfarming.com">contact@ibidunfarming.com</a></div>
    </footer>
  </body>
</html>
