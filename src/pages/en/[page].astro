---
import SitePage from '../../components/SitePage.astro';
import { pageKeys } from '../../lib/content';
export function getStaticPaths() { return pageKeys.map((page) => ({ params: { page }, props: { page, locale: 'en' } })); }
const { page, locale } = Astro.props;
---
<SitePage page={page} locale={locale} />
