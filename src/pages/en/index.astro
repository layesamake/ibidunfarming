---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copies } from '../../lib/content';
const copy = copies.en;
---
<BaseLayout locale="en">
  <section class="hero"><div><p class="eyebrow">{copy.home.eyebrow}</p><h1>{copy.home.title}</h1><p class="lede">{copy.home.intro}</p><div class="hero-actions"><a class="button" href="/en/solutions">{copy.home.primaryCta} ↗</a><a class="text-link" href="/en/contact">{copy.home.secondaryCta}</a></div></div><div class="hero-art"><span>IF</span><p>Agricultural solutions<br />for Africa</p></div></section>
  <section class="statement content-width"><p class="eyebrow">{copy.home.proof}</p><h2>{copy.home.proofText}</h2></section>
  <section class="home-grid content-width"><a href="/en/solutions"><span>01</span><h2>Solutions</h2><p>Genetics, equipment, buildings and support.</p></a><a href="/en/training"><span>02</span><h2>Training</h2><p>Practical foundations for better farm management.</p></a><a href="/en/news"><span>03</span><h2>Resources</h2><p>Official content and brand announcements.</p></a></section>
</BaseLayout>
