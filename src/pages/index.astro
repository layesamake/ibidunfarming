---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copies } from '../lib/content';
const copy = copies.fr;
---
<BaseLayout locale="fr">
  <section class="hero"><div><p class="eyebrow">{copy.home.eyebrow}</p><h1>{copy.home.title}</h1><p class="lede">{copy.home.intro}</p><div class="hero-actions"><a class="button" href="/solutions">{copy.home.primaryCta} ↗</a><a class="text-link" href="/contact">{copy.home.secondaryCta}</a></div></div><div class="hero-art"><span>IF</span><p>Solutions agricoles<br />pour l’Afrique</p></div></section>
  <section class="statement content-width"><p class="eyebrow">{copy.home.proof}</p><h2>{copy.home.proofText}</h2></section>
  <section class="home-grid content-width"><a href="/solutions"><span>01</span><h2>Solutions</h2><p>Génétique, matériel, bâtiments et accompagnement.</p></a><a href="/training"><span>02</span><h2>Formation</h2><p>Des bases pratiques pour mieux piloter son élevage.</p></a><a href="/news"><span>03</span><h2>Ressources</h2><p>Les contenus officiels et les annonces de la marque.</p></a></section>
</BaseLayout>
