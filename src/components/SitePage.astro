---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copies, type Locale, type PageKey } from '../lib/content';
const { locale, page } = Astro.props as { locale: Locale; page: PageKey };
const copy = copies[locale];
const section = copy.sections[page];
const whatsapp = `https://wa.me/${import.meta.env.WHATSAPP_CI ?? '2250720282028'}?text=${encodeURIComponent(locale === 'fr' ? 'Bonjour Ibidun Farming, je souhaite obtenir des informations.' : 'Hello Ibidun Farming, I would like more information.')}`;
---
<BaseLayout locale={locale} title={section.title}>
  <section class="page-hero">
    <p class="eyebrow">{copy.navigation[page]}</p>
    <h1>{section.title}</h1>
    <p class="lede">{section.intro}</p>
  </section>
  {page === 'solutions' && <section class="cards content-width">{copy.solutionCards.map((card) => <article class="card"><span>{card.tag}</span><h2>{card.title}</h2><p>{card.text}</p><a href={locale === 'fr' ? '/contact' : '/en/contact'}>{locale === 'fr' ? 'Demander un devis' : 'Request a quote'} ↗</a></article>)}</section>}
  {page === 'training' && <section class="training content-width"><div><p class="eyebrow">{locale === 'fr' ? 'Programme de référence' : 'Reference programme'}</p><h2>{locale === 'fr' ? 'Une formation pratique en six modules.' : 'Practical training in six modules.'}</h2><p>{locale === 'fr' ? 'Le programme historique couvre deux mois de formation en ligne. Les dates, le tarif et les conditions de la prochaine session seront publiés depuis WordPress après validation.' : 'The historical programme covers two months of online training. Dates, pricing and conditions for the next session will be published from WordPress once validated.'}</p></div><ol>{copy.trainingModules.map((module, index) => <li><b>0{index + 1}</b>{module}</li>)}</ol></section>}
  {page === 'about' && <section class="split content-width"><div><p class="eyebrow">Ibidun Farming</p><h2>{locale === 'fr' ? 'Une expertise qui relie la ferme et la transmission.' : 'Expertise connecting farms and knowledge.'}</h2></div><p>{locale === 'fr' ? 'La marque s’exprime autour de la cuniculture, de la formation et de solutions adaptées aux réalités africaines. Les éléments historiques sur la société et son équipe seront publiés après validation dans le nouveau back-office.' : 'The brand focuses on rabbit farming, training and solutions adapted to African realities. Historical company and team details will be published after validation in the new back office.'}</p></section>}
  {page === 'projects' && <section class="feature content-width"><p class="eyebrow">{locale === 'fr' ? 'À venir' : 'Coming next'}</p><h2>{locale === 'fr' ? 'Un portfolio alimenté depuis WordPress.' : 'A portfolio powered by WordPress.'}</h2><p>{locale === 'fr' ? 'Chaque réalisation pourra être publiée, traduite, illustrée et activée ou désactivée depuis le back-office.' : 'Each project can be published, translated, illustrated and enabled or disabled from the back office.'}</p></section>}
  {page === 'news' && <section class="feature content-width"><p class="eyebrow">YouTube · Facebook</p><h2>{locale === 'fr' ? 'Les contenus officiels, sélectionnés par l’équipe.' : 'Official content, selected by the team.'}</h2><p>{locale === 'fr' ? 'La connexion YouTube pourra afficher automatiquement les vidéos, avec un contrôle éditorial pour activer ou masquer chaque publication. Facebook restera désactivé jusqu’à l’obtention des accès API.' : 'YouTube content can be imported automatically, with editorial controls to enable or hide each publication. Facebook will remain disabled until API access is available.'}</p></section>}
  {page === 'contact' && <section class="contact content-width"><div><h2>{copy.contact.title}</h2><p>{copy.contact.text}</p><div class="contact-actions"><a class="button" href="mailto:contact@ibidunfarming.com">{copy.contact.emailLabel}</a><a class="button button-ghost" href={whatsapp} target="_blank" rel="noreferrer">{copy.contact.whatsappLabel}</a></div></div><form action="mailto:contact@ibidunfarming.com" method="post" enctype="text/plain"><label>{locale === 'fr' ? 'Nom' : 'Name'}<input name="name" required /></label><label>{locale === 'fr' ? 'Votre demande' : 'Your request'}<textarea name="message" rows="6" required></textarea></label><button class="button" type="submit">{copy.contact.formCta}</button></form></section>}
</BaseLayout>
